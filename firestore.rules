rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function ownerPath(){return /databases/$(database)/documents/system/bootstrap;}
  function adminPath(){return /databases/$(database)/documents/corporateAdmins/$(request.auth.uid);}
  function isAdmin(){return signedIn() && exists(adminPath()) && get(adminPath()).data.active == true;}
  // One-time atomic bootstrap. First verified-email registrant becomes owner.
  // Deploy rules and complete onboarding immediately; do not publicize site before claiming.
  function initialClaim(uid){
   return signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true &&
     !exists(ownerPath()) && existsAfter(ownerPath()) &&
     getAfter(ownerPath()).data.ownerUid == uid &&
     getAfter(ownerPath()).data.initialized == true;
  }
  match /system/bootstrap {
   allow get: if signedIn();
   allow list: if false;
   allow create: if signedIn() && request.auth.token.email_verified == true &&
    !exists(ownerPath()) && request.resource.data.keys().hasOnly(['ownerUid','initialized','createdAt']) &&
    request.resource.data.ownerUid == request.auth.uid && request.resource.data.initialized == true &&
    existsAfter(adminPath()) && getAfter(adminPath()).data.active == true &&
    getAfter(adminPath()).data.role == 'owner';
   allow update, delete: if false;
  }
  match /corporateAdmins/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow list: if false;
   allow create: if initialClaim(uid) &&
    request.resource.data.keys().hasOnly(['active','role','createdAt']) &&
    request.resource.data.active == true && request.resource.data.role == 'owner';
   allow update,delete: if false;
  }
  match /corporateEmployees/{employeeId} {
   allow get,list: if isAdmin();
   allow create: if isAdmin() && request.resource.data.keys().hasOnly(['displayName','department','title','subsidiary','status','employmentType','createdAt','updatedAt','createdBy']) &&
      request.resource.data.displayName is string && request.resource.data.displayName.size() > 1 &&
      request.resource.data.displayName.size() <= 120 &&
      request.resource.data.subsidiary in ['corporate','motors','mutual'] &&
      request.resource.data.status in ['active','leave','inactive'] &&
      request.resource.data.createdBy == request.auth.uid;
   allow update: if isAdmin() &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','department','title','subsidiary','status','employmentType','updatedAt']) &&
      request.resource.data.displayName is string && request.resource.data.displayName.size() > 1 &&
      request.resource.data.displayName.size() <= 120 &&
      request.resource.data.subsidiary in ['corporate','motors','mutual'] &&
      request.resource.data.status in ['active','leave','inactive'];
   allow delete: if false;
  }

  // Corporate-only job assignments. Existing Motors/Mutual identities are never changed.
  match /corporatePositions/{id} {
   allow read: if isAdmin();
   allow create: if isAdmin() &&
    request.resource.data.keys().hasOnly(['employeeId','managerId','subsidiary','title','payType','rateCents','status','createdBy','createdAt','updatedAt']) &&
    request.resource.data.employeeId is string && request.resource.data.employeeId.size() > 0 &&
    exists(/databases/$(database)/documents/corporateEmployees/$(request.resource.data.employeeId)) &&
    request.resource.data.managerId is string && request.resource.data.managerId != request.resource.data.employeeId &&
    request.resource.data.subsidiary in ['corporate','motors','mutual'] &&
    request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
    request.resource.data.payType in ['hourly','salary'] &&
    request.resource.data.rateCents is int && request.resource.data.rateCents >= 0 && request.resource.data.rateCents <= 100000000 &&
    request.resource.data.status == 'active' && request.resource.data.createdBy == request.auth.uid;
   allow update: if isAdmin() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
    request.resource.data.status in ['active','inactive'];
   allow delete: if false;
  }
  match /corporatePeopleEvents/{id} {
   allow read: if isAdmin();
   allow create: if isAdmin() &&
    request.resource.data.keys().hasOnly(['kind','employeeId','detail','actorUid','createdAt']) &&
    request.resource.data.kind in ['position-created','position-status'] &&
    request.resource.data.employeeId is string &&
    request.resource.data.detail is string && request.resource.data.detail.size() <= 200 &&
    request.resource.data.actorUid == request.auth.uid;
   allow update,delete: if false;
  }
  match /simulatedPayRecords/{id} {
   allow read: if isAdmin();
   allow create: if isAdmin() &&
    request.resource.data.keys().hasOnly(['employeeId','positionId','positionTitle','subsidiary','payType','rateCents','regularHours','overtimeHours','bonusCents','grossCents','status','createdBy','createdAt']) &&
    request.resource.data.employeeId is string && request.resource.data.positionId is string &&
    request.resource.data.positionTitle is string &&
    request.resource.data.subsidiary in ['corporate','motors','mutual'] &&
    request.resource.data.payType in ['hourly','salary'] &&
    request.resource.data.rateCents is int && request.resource.data.rateCents >= 0 &&
    request.resource.data.regularHours is number && request.resource.data.regularHours >= 0 && request.resource.data.regularHours <= 744 &&
    request.resource.data.overtimeHours is number && request.resource.data.overtimeHours >= 0 && request.resource.data.overtimeHours <= 744 &&
    request.resource.data.bonusCents is int && request.resource.data.bonusCents >= 0 &&
    request.resource.data.grossCents is int && request.resource.data.grossCents >= 0 &&
    request.resource.data.status == 'simulated' && request.resource.data.createdBy == request.auth.uid &&
    exists(/databases/$(database)/documents/corporatePositions/$(request.resource.data.positionId)) &&
    get(/databases/$(database)/documents/corporatePositions/$(request.resource.data.positionId)).data.employeeId == request.resource.data.employeeId;
   allow update,delete: if false;
  }

  match /corporatePayPeriods/{id} {
    allow read: if isAdmin();
    allow create: if isAdmin()
      && request.resource.data.keys().hasOnly(['start','end','status','createdBy','createdAt'])
      && request.resource.data.start is string
      && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.end is string
      && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.start <= request.resource.data.end
      && request.resource.data.status == 'open'
      && request.resource.data.createdBy == request.auth.uid;
    allow update, delete: if false;
  }
  match /corporateTimesheets/{id} {
   allow read: if isAdmin();
   allow create: if isAdmin() &&
      request.resource.data.keys().hasOnly(['employeeId','positionId','periodId','regularHours','overtimeHours','grossCents','status','createdBy','lastActor','createdAt','updatedAt']) &&
      request.resource.data.employeeId is string && request.resource.data.positionId is string &&
      request.resource.data.periodId is string &&
      exists(/databases/$(database)/documents/corporatePayPeriods/$(request.resource.data.periodId)) &&
      exists(/databases/$(database)/documents/corporatePositions/$(request.resource.data.positionId)) &&
      get(/databases/$(database)/documents/corporatePositions/$(request.resource.data.positionId)).data.employeeId == request.resource.data.employeeId &&
      request.resource.data.regularHours is number && request.resource.data.regularHours >= 0 && request.resource.data.regularHours <= 744 &&
      request.resource.data.overtimeHours is number && request.resource.data.overtimeHours >= 0 && request.resource.data.overtimeHours <= 744 &&
      request.resource.data.grossCents is int && request.resource.data.grossCents >= 0 &&
      request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.lastActor == request.auth.uid;
   allow update: if isAdmin() &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastActor']) &&
      request.resource.data.lastActor == request.auth.uid &&
      ((resource.data.status == 'draft' && request.resource.data.status == 'submitted') ||
       (resource.data.status == 'submitted' && request.resource.data.status in ['approved','rejected']) ||
       (resource.data.status == 'rejected' && request.resource.data.status == 'draft'));
   allow delete: if false;
  }
  // Materialized subsidiary snapshots: Corporate admins can read; browser writes prohibited.
  // Only explicitly scoped server credentials may import these observations.
  match /subsidiaryStaffSnapshots/{id} {
    allow get, list: if isAdmin();
    allow create, update, delete: if false;
  }
  match /subsidiaries/{id} {allow read: if isAdmin();allow write: if false;}
  match /integrationRuns/{id} {allow read: if isAdmin();allow write: if false;}
  match /employeeIdentityLinks/{id} {
    allow read: if isAdmin();
    allow create: if isAdmin()
      && request.resource.data.keys().hasOnly(['employeeId','projectId','subsidiaryUid','status','requestedBy','createdAt'])
      && request.resource.data.projectId in ['sterling-motors','sterling-mutual-insurance']
      && request.resource.data.subsidiaryUid is string
      && request.resource.data.subsidiaryUid.size() > 0
      && request.resource.data.subsidiaryUid.size() <= 128
      && id == request.resource.data.projectId + '_' + request.resource.data.subsidiaryUid
      && request.resource.data.employeeId is string
      && exists(/databases/$(database)/documents/corporateEmployees/$(request.resource.data.employeeId))
      && request.resource.data.status == 'pending-review'
      && request.resource.data.requestedBy == request.auth.uid;
    allow update,delete: if false;
  }
  match /{document=**} {allow read,write: if false;}
 }
}
